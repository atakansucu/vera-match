# --- Client (safe to ship in the app bundle) ---
# Only EXPO_PUBLIC_* variables are exposed to the mobile app. NEVER put secrets here.

# Backend selection: "dev" (in-memory, seeded) or "supabase"
EXPO_PUBLIC_BACKEND=dev

# Supabase project (only needed when EXPO_PUBLIC_BACKEND=supabase)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Closed-beta community email allow-list (comma separated). Empty = allow any email.
# Example: tum.de,mytum.de,lmu.de
EXPO_PUBLIC_BETA_ALLOWED_EMAIL_DOMAINS=

# --- Server only (Supabase Edge Functions) ---
# These MUST NOT be prefixed with EXPO_PUBLIC_ and MUST NOT reach the app bundle.
# Configure them as Edge Function secrets, not in the client build.
# OPENAI_API_KEY=
# OPENAI_FAST_MODEL=gpt-5.6-luna
# OPENAI_REASONING_MODEL=gpt-5.6-terra
# SUPABASE_SERVICE_ROLE_KEY=
